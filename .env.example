# Expo inlines every EXPO_PUBLIC_* value into the client bundle. These values
# must be public configuration only; never add an Unsplash or RevenueCat secret
# API key to this file.

# HTTPS base URL printed by the successful Cloudflare Worker deployment.
# Do not append /photo or /track.
EXPO_PUBLIC_PHOTO_API_URL=

# Platform-specific RevenueCat public SDK keys. Never use a RevenueCat secret
# key (including any key with an sk_ prefix) in an Expo client variable.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Exact App Store Connect identifier of the reviewed non-consumable unlock.
EXPO_PUBLIC_REVENUECAT_IOS_PREMIUM_CUTS_PRODUCT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Privacy must be a live HTTPS policy page. Support accepts HTTPS or mailto in
# the app, but use an HTTPS contact page to satisfy App Store support metadata.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Anonymous product analytics. Both must be set for any event to be sent; with
# either one empty the app collects nothing and the Usage Data privacy answer
# does not apply. The host is a bare origin; the code appends /batch/.
#
# The host MUST match the cloud region the project was created in:
#   https://us.i.posthog.com   for a US project
#   https://eu.i.posthog.com   for an EU project
# These are separate deployments and a token exists in only one of them. Getting
# this wrong fails silently and expensively: the capture endpoint answers
# 200 {"status":"Ok"} to a token from the other region and then drops the event.
# `npm run analytics:verify` authenticates the token before sending and is the
# only cheap way to tell the two apart.
#
# The key must be the PostHog *project token*, which starts with phc_ and is
# designed to be public. A PostHog *personal API key* starts with phx_ and
# grants read and write access to the whole account: it would be inlined into
# the shipped bundle like every other value in this file, and it does not
# authenticate the capture endpoint anyway. The client refuses to send with a
# non-phc_ key, and the archive bundle scan refuses to ship a phx_ one.
EXPO_PUBLIC_ANALYTICS_HOST=
EXPO_PUBLIC_ANALYTICS_API_KEY=
