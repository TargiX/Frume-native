# Expo inlines every EXPO_PUBLIC_* value into the client bundle. These values
# must be public configuration only; never add an Unsplash or RevenueCat secret
# API key to this file.

# HTTPS base URL printed by the successful Cloudflare Worker deployment.
# Do not append /photo or /track.
EXPO_PUBLIC_PHOTO_API_URL=

# Platform-specific RevenueCat public SDK keys. Never use a RevenueCat secret
# key (including any key with an sk_ prefix) in an Expo client variable.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# Exact App Store Connect identifier of the reviewed non-consumable unlock.
EXPO_PUBLIC_REVENUECAT_IOS_PREMIUM_CUTS_PRODUCT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Privacy must be a live HTTPS policy page. Support accepts HTTPS or mailto in
# the app, but use an HTTPS contact page to satisfy App Store support metadata.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_URL=
