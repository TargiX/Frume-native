{
  "name": "frume-native",
  "version": "1.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.13.0",
      "onFail": "error"
    }
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "preinstall": "node ./scripts/validate-toolchain.mjs",
    "eas-build-pre-install": "node ./scripts/guard-eas-build.mjs",
    "toolchain:check": "node ./scripts/validate-toolchain.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:archive": "./scripts/archive-ios-release.sh",
    "ios:release:simulator": "./scripts/build-ios-release-simulator.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server test",
    "doctor": "EXPO_NO_DOTENV=1 expo-doctor",
    "security:dependencies": "node ./scripts/validate-dependency-audit.mjs",
    "release:verify:public-pages": "FRUME_VERIFY_PUBLIC_RELEASE_PAGES=1 node ./scripts/validate-public-release-pages.mjs",
    "analytics:verify": "FRUME_VERIFY_ANALYTICS=1 node ./scripts/verify-analytics-transport.mjs",
    "ota:verify": "node ./scripts/validate-ota-config.mjs",
    "ota:publish": "./scripts/publish-ota-update.sh",
    "release:guards": "npm run toolchain:check && sh -n scripts/archive-ios-release.sh scripts/build-ios-release-simulator.sh scripts/publish-ota-update.sh scripts/test-production-photo-api-url.sh && node --test scripts/release-hardening.test.mjs scripts/release-revision-adversarial.test.mjs scripts/release-stage-handoff.test.mjs scripts/dependency-audit.test.mjs scripts/public-release-page-content-contract.test.mjs scripts/validate-production-photo-api-health.test.mjs scripts/validate-ota-config.test.mjs scripts/publish-ota-update.test.mjs && node support-site/check.mjs && ./scripts/test-production-photo-api-url.sh",
    "check": "npm run typecheck && npm test && npm run server:typecheck && npm run server:test && npm run doctor && npm run release:guards"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/react-native-skia": "2.2.12",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^10.5.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "expo-doctor": "^1.20.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  },
  "private": true
}
